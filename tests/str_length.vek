func main() int {
    // String length on a literal, a variable, and the empty string
    print("hello".length());
    let str s = "abc";
    print(s.length());
    print("".length());

    // Length assigned to a variable and used in expressions
    let int n = "VekLang".length();
    print(n);
    print(s.length() + 1);

    // Array length (element count) through the same opcode
    let int arr[] = {1, 2, 3};
    print(arr.length());
    arr.push(4);
    print(arr.length());

    ret 0;
}
