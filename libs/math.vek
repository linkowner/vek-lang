# Math.vek
# Standard Math Library for VekLang

// Constants
const float PI = 3.14159;

// Rounding
func floor(float num) int {
    let int truncated = (int)num;
    if (num < 0.0 && num != (float)truncated) {
        ret truncated - 1;
    }
    ret truncated;
}

func ceil(float num) int {
    let int truncated = (int)num;
    if (num > 0.0 && num != (float)truncated) {
        ret truncated + 1;
    }
    ret truncated;
}

func round(float num) int {
    if (num < 0.0) {
        ret ceil(num - 0.5);
    }
    ret floor(num + 0.5);
}

// Basic Math
func abs(int num) int {
    if (num < 0) {
        ret -num;
    }
    ret num;
}

func min(int a, int b) int {
    if (a < b) { ret a; }
    ret b;
}

func max(int a, int b) int {
    if (a > b) { ret a; }
    ret b;
}

// Power & Square Root
func pow(int num, int power) int {
    let int result = 1;
    for (let int i = 0; i < power; i += 1) {
        result = result * num;
    }
    ret result;
}

func sqrt(int num) int {
    if (num < 0) { ret -1; }
    if (num == 0) { ret 0; }

    let int x = num;
    let int y = (x + 1) / 2;

    // Newton iteration
    while (y < x) {
        x = y;
        y = (x + num / x) / 2;
    }
    ret floor((float)x);
}

func mod(int a, int b) int {
    ret a - (a / b) * b;
}
